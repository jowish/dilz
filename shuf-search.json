<script>
	window.onload = function () {
		if (miglog.isShowTeaserMarketPlace_pageSearch) {
			var text = document.getElementById('js-search-title').getAttribute('data-search');
			var noResultsFromOnline = false

					miglog.marketplaceApiHelpers.isResultsFromMarketPlace(text).then(function (result) {
						if (result && noResultsFromOnline) //but no results in online
							$('.noSearchResult .teaserMP_search.nosearchResults').css('display', 'flex');
						else if (result)
							$('.teaserMP_search').css('display', 'flex');

					});
		}
	}
</script>