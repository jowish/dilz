NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
OPENFOODFACTS_CONTACT=you@example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Moderation API
ADMIN_BOT_TOKEN=generate-a-long-random-secret

# Claude. Reads deal details out of a screenshot when someone posts one
# (pages/api/deal-extract.js), and powers scripts/claude-deal-scout.js.
# Optional: without it, deal details are still read from a pasted link.
ANTHROPIC_API_KEY=

# Automated deal discovery. Comma-separated public/authorized sources.
DEAL_BOT_TELEGRAM_CHANNELS=
DEAL_BOT_RSS_FEEDS=
DEAL_BOT_FACEBOOK_PAGE_IDS=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
DEAL_BOT_MIN_SCORE=65
DEAL_BOT_MAX_PER_RUN=25
DEAL_BOT_DRY_RUN=false

# Optional web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
